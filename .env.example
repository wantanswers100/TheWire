# Wire Platform — credential template
# Copy to .env and fill in real values. Never put real keys in this file.

# ─── API keys ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-key-from-ai-studio
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Ollama ──────────────────────────────────────────────────────────────────
# All optional. Defaults shown. Change to swap models without touching source.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_QUICK=phi3:mini
# OLLAMA_SUMMARIZE=phi3:mini
# OLLAMA_CLASSIFY=phi3.5
# OLLAMA_EXPLAIN=phi3.5
# OLLAMA_CODE_REVIEW=codegemma:2b
# OLLAMA_DEBUG=codegemma:2b
# OLLAMA_DEFAULT=phi3:mini

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Used by memory + RAG. Must match embedding dimension (768 for nomic-embed-text).
# EMBED_MODEL=nomic-embed-text

# ─── Gemini ──────────────────────────────────────────────────────────────────
# GEMINI_RESEARCH=gemini-2.5-flash
# GEMINI_PLAN=gemini-2.5-flash
# GEMINI_EXPLAIN=gemini-2.5-flash
# GEMINI_VERIFY=gemini-2.5-flash
# GEMINI_IMPLEMENT=gemini-2.5-flash
# GEMINI_ARCHITECT=gemini-2.5-flash
# GEMINI_REFACTOR=gemini-2.5-flash
# GEMINI_AUDIT=gemini-2.5-flash
# GEMINI_DEFAULT=gemini-2.5-flash-lite
